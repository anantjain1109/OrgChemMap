  <style>
    :root {
      --bg: #0d1117;
      --card-bg: #161b22;
      --border: #30363d;
      --text: #c9d1d9;
      --text-muted: #8b949e;
      --heading: #f0f6fc;
      --accent: #58a6ff;
      --accent-hover: #1f6feb;
      --warning: #d29922;
      --danger: #f85149;
      --success: #3fb950;
      --code-bg: #21262d;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 1rem;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding-bottom: 3rem;
    }

    header {
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      color: var(--accent);
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    h1 {
      color: var(--heading);
      font-size: 2rem;
      margin-bottom: 0.25rem;
    }

    .meta {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    h2 {
      color: var(--heading);
      font-size: 1.4rem;
      margin: 2rem 0 1rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.3rem;
    }

    h3 {
      color: var(--heading);
      font-size: 1.15rem;
      margin: 1.25rem 0 0.5rem;
    }

    p {
      margin-bottom: 1rem;
    }

    .table-container {
      width: 100%;
      overflow-x: auto;
      margin-bottom: 1.5rem;
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }

    th, td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    th {
      background-color: var(--card-bg);
      color: var(--heading);
      font-weight: 600;
      white-space: nowrap;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background-color: rgba(255, 255, 255, 0.02);
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.25rem;
      margin-bottom: 1.25rem;
    }

    .trap-card {
      border-left: 4px solid var(--warning);
      background-color: var(--card-bg);
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 0 6px 6px 0;
    }

    .trap-title {
      font-weight: 600;
      color: var(--warning);
      margin-bottom: 0.3rem;
    }

    .order-box {
      background-color: var(--card-bg);
      border-left: 4px solid var(--accent);
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 0 6px 6px 0;
    }

